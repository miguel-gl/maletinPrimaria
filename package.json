{
  "name": "maletinprimaria",
  "version": "1.0.0",
  "description": "App de escritorio para docentes de primaria NEM",
  "main": "main.js",
  "author": "SAI",
  "scripts": {
    "start": "electron .",
    "build": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "consolidate:resources": "node src/scripts/consolidateMetadataResources.js",
    "generate:embeddings": "node src/scripts/generateEmbeddings.js",
    "rebuild:embeddings": "npm run consolidate:resources && npm run generate:embeddings"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^32.2.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "mx.maletinprimaria.app",
    "productName": "Maletin Primaria",
    "copyright": "SAI",
    "files": [
      "main.js",
      "preload.js",
      "*.html",
      "assets/**",
      "vendors/**",
      "components/**",
      "src/ai/**",
      "src/metadata/**",
      "src/resources/**",
      "!src/metadata/fase3/planos_didacticos_old.json",
      "!assets/js/inicio-beta-v2.js",
      "!assets/js/inicio-beta-v3.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/img/lineicons/maletin.png",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Maletin Primaria"
    },
    "publish": {
      "provider": "github",
      "owner": "miguel-gl",
      "repo": "maletinPrimaria"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    }
  }
}
